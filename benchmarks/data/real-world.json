  "tsconfigJson": {
    "valid": [
      {
        "compilerOptions": {
          "target": "ES2020",
          "module": "commonjs",
          "lib": ["ES2020"],
          "outDir": "./dist",
          "rootDir": "./src",
          "strict": true,
          "esModuleInterop": true,
          "skipLibCheck": true,
          "forceConsistentCasingInFileNames": true,
          "declaration": true,
          "sourceMap": true,
          "moduleResolution": "node",
          "baseUrl": ".",
          "paths": { "@/*": ["src/*"] },
          "types": ["node", "jest"]
        },
        "include": ["src/**/*"],
        "exclude": ["node_modules", "dist"]
      }
    ],
    "invalid": [
      {
        "compilerOptions": {
          "target": "ES2020",
          "module": "commonjs",
