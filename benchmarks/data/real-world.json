          "esModuleInterop": true,
          "skipLibCheck": true,
          "forceConsistentCasingInFileNames": true,
          "declaration": true,
          "sourceMap": true,
          "moduleResolution": "classic",
          "baseUrl": ".",
          "paths": { "@/*": ["src/*"] },
          "types": ["node", 123]
        },
        "include": ["src/**/*"],
        "exclude": ["node_modules", "dist"]
      }
    ]
  },
  "openApiPath": {
    "valid": [
      {
        "summary": "Get user by ID",
        "operationId": "getUserById",
        "tags": ["users"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "User ID",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
