{
  "name": "@jetio/validator",
  "version": "2.0.3",
  "description": "Compile schema to functions with Type Inference. Supports Draft 06, 07, 2019-09, and 2020-12.",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "browser": "dist/validator.umd.js",
  "unpkg": "dist/validator.umd.js",
  "jsdelivr": "dist/validator.umd.js",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.js",
      "types": "./dist/index.d.ts",
      "browser": "./dist/validator.umd.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run clean && npm run bundle",
    "clean": "rm -rf dist/",
    "lint": "eslint src --ext .ts",
    "bundle": "rollup -c",
    "test:jet": "vitest run tests/jet",
    "test:suite": "npm run test:2020-12 && npm run test:2019-09 && npm run test:7 && npm run test:6",
    "test:2020-12": "TEST_PATH=./JSON-Schema-Test-Suite/tests/draft2020-12 vitest run tests/json-schema-test-suite/suite.test.ts",
    "test:2019-09": "TEST_PATH=./JSON-Schema-Test-Suite/tests/draft2019-09 vitest run tests/json-schema-test-suite/suite.test.ts",
    "test:7": "TEST_PATH=./JSON-Schema-Test-Suite/tests/draft7 vitest run tests/json-schema-test-suite/suite.test.ts",
    "test:6": "TEST_PATH=./JSON-Schema-Test-Suite/tests/draft6 vitest run tests/json-schema-test-suite/suite.test.ts",
    "bench": "TS_NODE_PROJECT=benchmarks/tsconfig.json node --expose-gc -r ts-node/register benchmarks/benchmark.ts"
  },
  "bin": {
    "jet-meta": "dist/cli.js"
  },
  "keywords": [
    "fast validation",
    "compile schema to functions",
    "compile schema",
    "schema compilation",
    "fast validator",
    "json-schema",
    "validator",
    "validation",
    "schema",
    "json",
    "typescript",
    "ajv",
    "ajv-alternative",
    "fast",
    "performance",
    "draft-2020-12",
    "draft-2019-09",
    "draft-07",
    "draft-06",
    "JSON",
    "jsonschema",
    "json-schema-validator",
    "json-schema-validation"
  ],
  "author": "Great Venerable",
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0"
  },
  "sideEffects": false,
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^5.58.0",
    "@typescript-eslint/parser": "^5.58.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^8.57.1",
    "mitata": "^1.0.34",
    "rollup": "^4.63.1",
    "rollup-plugin-bundle-size": "^1.0.3",
    "rollup-plugin-visualizer": "^5.14.0",
    "strip-comments": "^2.0.1",
    "terser": "^5.46.0",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/official-jetio/validator.git"
  },
  "bugs": {
    "url": "https://github.com/official-jetio/validator/issues"
  },
  "homepage": "https://github.com/official-jetio/validator#readme"
}
